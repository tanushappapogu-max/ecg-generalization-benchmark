{
  "definition_version": "normal-vs-any-benchmark-abnormal-v1",
  "normal_rule": "normal=1 and no abnormal benchmark label",
  "abnormal_rule": "OR(af_afl, av_block_1, lbbb, rbbb)",
  "normal_plus_abnormal_rule": "abnormal wins",
  "all_zero_rule": "excluded",
  "architectures": [
    "ecg_fm",
    "inception_time",
    "resnet1d",
    "transformer"
  ],
  "seed": 42,
  "epochs": 50,
  "patience": 10,
  "ecg_fm": {
    "batch_size": 4,
    "gradient_accumulation_steps": 8,
    "learning_rate": 1e-6,
    "weight_decay": 0.0001
  },
  "inception_time": {
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "module_channels": 32,
    "depth": 6
  },
  "resnet1d": {
    "batch_size": 32,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "base_channels": 32,
    "blocks_per_stage": [2, 2, 2, 2]
  },
  "transformer": {
    "batch_size": 32,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "patch_size": 50,
    "embed_dim": 128,
    "heads": 4,
    "layers": 4,
    "feedforward_dim": 256
  }
}
